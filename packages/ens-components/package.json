{
  "name": "ens-components",
  "version": "0.1.0",
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.mts",
  "imports": {
    "#/components": "./src/components/index.ts",
    "#/*": "./src/*"
  },
  "exports": {
    ".": {
      "@thenamespace/source": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./styles": {
      "@thenamespace/source": "./src/styles.css",
      "style": "./dist/styles.css",
      "default": "./dist/styles.css"
    },
    "./styles.css": {
      "@thenamespace/source": "./src/styles.css",
      "style": "./dist/styles.css",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "dev": "tsdown --config tsdown.config.ts --watch",
    "format": "oxfmt . --write --no-error-on-unmatched-pattern",
    "format:check": "oxfmt . --check --no-error-on-unmatched-pattern",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix --no-error-on-unmatched-pattern",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "@internationalized/date": "3.12.2",
    "@number-flow/react": "0.6.2",
    "@thenamespace/uikit": "workspace:*",
    "motion": "12.42.2",
    "neverthrow": "8.2.0",
    "usehooks-ts": "3.1.1"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.101.2",
    "@types/node": "26.0.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-query": "5.101.2",
    "react": ">=19.2.7 <20",
    "react-dom": ">=19.2.7 <20",
    "tailwindcss": ">=4.3.2 <5",
    "viem": ">=2.55.0 <3",
    "wagmi": ">=3.7.1 <4"
  }
}
