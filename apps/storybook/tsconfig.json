{
  "extends": "klarity/tsconfig/app/vite",
  "compilerOptions": {
    "baseUrl": ".",
    "customConditions": ["@thenamespace/source"],
    "exactOptionalPropertyTypes": false,
    "ignoreDeprecations": "6.0",
    "noImplicitAny": false,
    "noPropertyAccessFromIndexSignature": false,
    "noUncheckedIndexedAccess": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["node", "vite/client"]
  },
  "exclude": [
    "node_modules",
    "storybook-static",
    ".storybook/stories/**",
    "src/components/**/*.stories.tsx"
  ],
  "include": [
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts"
  ]
}
