{
  "name": "ens-components",
  "version": "0.2.0",
  "description": "Production-ready React components, hooks, and contract actions for integrating ENS v2 into React applications.",
  "keywords": [
    "components",
    "ens",
    "ens-v2",
    "ethereum",
    "ethereum-name-service",
    "hooks",
    "react",
    "typescript",
    "viem",
    "wagmi",
    "web3"
  ],
  "homepage": "https://github.com/thenamespace/uikit/tree/main/packages/ens-components#readme",
  "bugs": {
    "url": "https://github.com/thenamespace/uikit/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenamespace/uikit.git",
    "directory": "packages/ens-components"
  },
  "files": [
    "dist",
    "README.md",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.mts",
  "imports": {
    "#/components": "./src/components/index.ts",
    "#/*": "./src/*"
  },
  "exports": {
    ".": {
      "@thenamespace/source": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./actions": {
      "@thenamespace/source": {
        "types": "./src/actions/index.ts",
        "import": "./src/actions/index.ts"
      },
      "types": "./dist/actions.d.mts",
      "import": "./dist/actions.mjs"
    },
    "./hooks": {
      "@thenamespace/source": {
        "types": "./src/hooks/index.ts",
        "import": "./src/hooks/index.ts"
      },
      "types": "./dist/hooks.d.mts",
      "import": "./dist/hooks.mjs"
    },
    "./icons": {
      "@thenamespace/source": {
        "types": "./src/icons/index.ts",
        "import": "./src/icons/index.ts"
      },
      "types": "./dist/icons.d.mts",
      "import": "./dist/icons.mjs"
    },
    "./styles": {
      "@thenamespace/source": "./src/styles.css",
      "style": "./dist/styles.css",
      "default": "./dist/styles.css"
    },
    "./styles.css": {
      "@thenamespace/source": "./src/styles.css",
      "style": "./dist/styles.css",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts && pnpm run build:styles",
    "build:styles": "tailwindcss -i src/utilities.css -o dist/utilities.css --minify",
    "dev": "tsdown --config tsdown.config.ts --watch",
    "format": "oxfmt . --write --no-error-on-unmatched-pattern",
    "format:check": "oxfmt . --check --no-error-on-unmatched-pattern",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint . --fix --no-error-on-unmatched-pattern",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  },
  "dependencies": {
    "@ensdomains/address-encoder": "1.1.4",
    "@ensdomains/content-hash": "3.1.1",
    "@internationalized/date": "3.12.2",
    "@number-flow/react": "0.6.2",
    "@thenamespace/uikit": "workspace:*",
    "motion": "12.42.2",
    "neverthrow": "8.2.0",
    "react-hook-form": "7.83.0",
    "tailwindcss": "catalog:",
    "usehooks-ts": "3.1.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "catalog:",
    "@tanstack/react-query": "5.101.2",
    "@types/node": "26.0.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-query": "5.101.2",
    "react": ">=19.2.7 <20",
    "react-dom": ">=19.2.7 <20",
    "viem": ">=2.55.0 <3",
    "wagmi": ">=3.7.1 <4"
  }
}
