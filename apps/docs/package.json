{
  "name": "@thenamespace/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "format": "oxfmt . --write --no-error-on-unmatched-pattern",
    "format:check": "oxfmt . --check --no-error-on-unmatched-pattern",
    "lint": "pnpm --dir ../.. exec oxlint apps/docs/src apps/docs/next.config.ts apps/docs/source.config.ts --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint src next.config.ts source.config.ts --fix --no-error-on-unmatched-pattern",
    "postinstall": "fumadocs-mdx",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "typegen": "next typegen"
  },
  "dependencies": {
    "@fuma-translate/react": "1.0.2",
    "@heroui/react": "catalog:",
    "@heroui/styles": "catalog:",
    "@internationalized/date": "catalog:",
    "@react-stately/data": "catalog:",
    "@tanstack/react-table": "8.21.3",
    "@thenamespace/uikit": "workspace:*",
    "clsx": "2.1.1",
    "culori": "4.0.2",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "emojibase-data": "17.0.0",
    "fumadocs-core": "16.13.0",
    "fumadocs-mdx": "14.2.2",
    "fumadocs-ui": "16.13.0",
    "lucide-react": "0.562.0",
    "m3-ripple": "1.1.3",
    "next": "16.2.12",
    "next-themes": "0.4.6",
    "react": "catalog:",
    "react-aria-components": "catalog:",
    "react-dom": "catalog:",
    "react-stately": "catalog:",
    "streamdown": "^2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/culori": "4.0.1",
    "@types/mdx": "2.0.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "postcss": "8.5.24",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
