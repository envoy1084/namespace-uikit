{
  "extends": "klarity/tsconfig/library/react",
  "compilerOptions": {
    "customConditions": ["@thenamespace/source"],
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "isolatedDeclarations": true,
    "module": "Preserve",
    "noEmitOnError": true,
    "outDir": "../../dist/typecheck/packages/uikit",
    "rootDir": "src",
    "stripInternal": true,
    "tsBuildInfoFile": "../../dist/typecheck/packages/uikit/tsconfig.tsbuildinfo",
    "types": ["react", "react-dom", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
